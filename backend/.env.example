# ==================================================
# Django core
# ==================================================
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ==================================================
# PostgreSQL
# ==================================================
DB_NAME=notox
DB_USER=notox_user
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# ==================================================
# Redis / Memurai
# (Not required for Stage 1 auth to function. Prepared for Channels,
# caching, OTP throttling and the Bloom filter in later stages.)
# ==================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ==================================================
# JWT
# ==================================================
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ==================================================
# CORS
# ==================================================
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ==================================================
# Twilio Verify (placeholder only — NOT required to run locally)
# Phone OTP verification is stubbed in Stage 1. See apps/accounts/services.py.
# ==================================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
