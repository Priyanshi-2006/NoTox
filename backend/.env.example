SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DB_ENGINE=sqlite3
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ==================================================
# CORS
# ==================================================
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ==================================================
# Twilio Verify (placeholder only — NOT required to run locally)
# Phone OTP verification is stubbed in Stage 1. See apps/accounts/services.py.
# ==================================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# ==================================================
# Chat Moderation & Bloom Pre-Filter (Stage 3B)
# ==================================================
BLOOM_BACKEND=local
BLOOM_REDIS_KEY=notox:bloom:toxic
BLOOM_CAPACITY=50000
BLOOM_ERROR_RATE=0.001
BLOOM_TIMEOUT_MS=20
BLOOM_MIN_TRUST=80
BLOOM_MAX_LENGTH=500
BLOOM_AUDIT_RATE=0.05

# ==================================================
# Layer 3 Contextual Moderation Provider Options:
#
# 1. MODERATION_PROVIDER=local   -> 100% FREE offline on-device AI (no keys, no credits, no 402)
# 2. MODERATION_PROVIDER=mock    -> Fast deterministic rule-based for dev/testing (0ms, 100% free)
# 3. MODERATION_PROVIDER=null    -> Fast-path Bloom + Keyword only (default, 100% free)
# 4. MODERATION_PROVIDER=gemini  -> Free cloud AI via Google AI Studio (1500 req/day free)
# 5. MODERATION_PROVIDER=huggingface -> Paid HF Inference API (requires pre-paid credits)
# ==================================================
MODERATION_PROVIDER=null

# Free Option 1: Local On-Device Transformers (uses transformers library)
LOCAL_MODEL_ID=unitary/toxic-bert

# Free Option 2: Google Gemini (Get free key at https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL_ID=gemini-2.0-flash

# Optional: HuggingFace Inference API (requires pre-paid credits or PRO subscription)
HF_API_TOKEN=
HF_MODEL_ID=unitary/toxic-bert
HF_API_TIMEOUT=5
HF_MAX_INPUT_LENGTH=512
CONTEXT_WINDOW_SIZE=5

# ==================================================
# Policy Engine Thresholds (Stage 5)
# Scores are in [0.0, 1.0]. Sarcasm alone never triggers a block.
# ==================================================
POLICY_TOXICITY_BLOCK=0.85
POLICY_THREAT_BLOCK=0.80
POLICY_HARASSMENT_BLOCK=0.80
POLICY_REVIEW_THRESHOLD=0.60
