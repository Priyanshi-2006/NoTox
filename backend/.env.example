BLOOM_REDIS_KEY=notox:bloom:toxic
BLOOM_CAPACITY=50000
BLOOM_ERROR_RATE=0.001
BLOOM_TIMEOUT_MS=20
BLOOM_MIN_TRUST=80
BLOOM_MAX_LENGTH=500
BLOOM_AUDIT_RATE=0.05
MODERATION_PROVIDER=null
